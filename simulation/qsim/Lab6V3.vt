// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "12/04/2023 19:33:39"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    Lab6Q3
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module Lab6Q3_vlg_sample_tst(
	A,
	A_Latch_Reset,
	B,
	B_Latch_Reset,
	Clock,
	Decoder_Enabler,
	FSM_Data_In,
	FSM_Reset,
	sampler_tx
);
input [7:0] A;
input  A_Latch_Reset;
input [7:0] B;
input  B_Latch_Reset;
input  Clock;
input  Decoder_Enabler;
input  FSM_Data_In;
input  FSM_Reset;
output sampler_tx;

reg sample;
time current_time;
always @(A or A_Latch_Reset or B or B_Latch_Reset or Clock or Decoder_Enabler or FSM_Data_In or FSM_Reset)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module Lab6Q3_vlg_check_tst (
	ID_Output,
	Lower_Output,
	sampler_rx
);
input [0:6] ID_Output;
input [0:6] Lower_Output;
input sampler_rx;

reg [0:6] ID_Output_expected;
reg [0:6] Lower_Output_expected;

reg [0:6] ID_Output_prev;
reg [0:6] Lower_Output_prev;

reg [0:6] ID_Output_expected_prev;
reg [0:6] Lower_Output_expected_prev;

reg [0:6] last_ID_Output_exp;
reg [0:6] last_Lower_Output_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:2] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 2'b1;
end

// update real /o prevs

always @(trigger)
begin
	ID_Output_prev = ID_Output;
	Lower_Output_prev = Lower_Output;
end

// update expected /o prevs

always @(trigger)
begin
	ID_Output_expected_prev = ID_Output_expected;
	Lower_Output_expected_prev = Lower_Output_expected;
end


// expected ID_Output[ 6 ]
initial
begin
	ID_Output_expected[6] = 1'bX;
end 
// expected ID_Output[ 5 ]
initial
begin
	ID_Output_expected[5] = 1'bX;
end 
// expected ID_Output[ 4 ]
initial
begin
	ID_Output_expected[4] = 1'bX;
end 
// expected ID_Output[ 3 ]
initial
begin
	ID_Output_expected[3] = 1'bX;
end 
// expected ID_Output[ 2 ]
initial
begin
	ID_Output_expected[2] = 1'bX;
end 
// expected ID_Output[ 1 ]
initial
begin
	ID_Output_expected[1] = 1'bX;
end 
// expected ID_Output[ 0 ]
initial
begin
	ID_Output_expected[0] = 1'bX;
end 
// expected Lower_Output[ 6 ]
initial
begin
	Lower_Output_expected[6] = 1'bX;
end 
// expected Lower_Output[ 5 ]
initial
begin
	Lower_Output_expected[5] = 1'bX;
end 
// expected Lower_Output[ 4 ]
initial
begin
	Lower_Output_expected[4] = 1'bX;
end 
// expected Lower_Output[ 3 ]
initial
begin
	Lower_Output_expected[3] = 1'bX;
end 
// expected Lower_Output[ 2 ]
initial
begin
	Lower_Output_expected[2] = 1'bX;
end 
// expected Lower_Output[ 1 ]
initial
begin
	Lower_Output_expected[1] = 1'bX;
end 
// expected Lower_Output[ 0 ]
initial
begin
	Lower_Output_expected[0] = 1'bX;
end 
// generate trigger
always @(ID_Output_expected or ID_Output or Lower_Output_expected or Lower_Output)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected ID_Output = %b | expected Lower_Output = %b | ",ID_Output_expected_prev,Lower_Output_expected_prev);
	$display("| real ID_Output = %b | real Lower_Output = %b | ",ID_Output_prev,Lower_Output_prev);
`endif
	if (
		( ID_Output_expected_prev[0] !== 1'bx ) && ( ID_Output_prev[0] !== ID_Output_expected_prev[0] )
		&& ((ID_Output_expected_prev[0] !== last_ID_Output_exp[0]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port ID_Output[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", ID_Output_expected_prev);
		$display ("     Real value = %b", ID_Output_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_ID_Output_exp[0] = ID_Output_expected_prev[0];
	end
	if (
		( ID_Output_expected_prev[1] !== 1'bx ) && ( ID_Output_prev[1] !== ID_Output_expected_prev[1] )
		&& ((ID_Output_expected_prev[1] !== last_ID_Output_exp[1]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port ID_Output[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", ID_Output_expected_prev);
		$display ("     Real value = %b", ID_Output_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_ID_Output_exp[1] = ID_Output_expected_prev[1];
	end
	if (
		( ID_Output_expected_prev[2] !== 1'bx ) && ( ID_Output_prev[2] !== ID_Output_expected_prev[2] )
		&& ((ID_Output_expected_prev[2] !== last_ID_Output_exp[2]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port ID_Output[2] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", ID_Output_expected_prev);
		$display ("     Real value = %b", ID_Output_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_ID_Output_exp[2] = ID_Output_expected_prev[2];
	end
	if (
		( ID_Output_expected_prev[3] !== 1'bx ) && ( ID_Output_prev[3] !== ID_Output_expected_prev[3] )
		&& ((ID_Output_expected_prev[3] !== last_ID_Output_exp[3]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port ID_Output[3] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", ID_Output_expected_prev);
		$display ("     Real value = %b", ID_Output_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_ID_Output_exp[3] = ID_Output_expected_prev[3];
	end
	if (
		( ID_Output_expected_prev[4] !== 1'bx ) && ( ID_Output_prev[4] !== ID_Output_expected_prev[4] )
		&& ((ID_Output_expected_prev[4] !== last_ID_Output_exp[4]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port ID_Output[4] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", ID_Output_expected_prev);
		$display ("     Real value = %b", ID_Output_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_ID_Output_exp[4] = ID_Output_expected_prev[4];
	end
	if (
		( ID_Output_expected_prev[5] !== 1'bx ) && ( ID_Output_prev[5] !== ID_Output_expected_prev[5] )
		&& ((ID_Output_expected_prev[5] !== last_ID_Output_exp[5]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port ID_Output[5] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", ID_Output_expected_prev);
		$display ("     Real value = %b", ID_Output_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_ID_Output_exp[5] = ID_Output_expected_prev[5];
	end
	if (
		( ID_Output_expected_prev[6] !== 1'bx ) && ( ID_Output_prev[6] !== ID_Output_expected_prev[6] )
		&& ((ID_Output_expected_prev[6] !== last_ID_Output_exp[6]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port ID_Output[6] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", ID_Output_expected_prev);
		$display ("     Real value = %b", ID_Output_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_ID_Output_exp[6] = ID_Output_expected_prev[6];
	end
	if (
		( Lower_Output_expected_prev[0] !== 1'bx ) && ( Lower_Output_prev[0] !== Lower_Output_expected_prev[0] )
		&& ((Lower_Output_expected_prev[0] !== last_Lower_Output_exp[0]) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Lower_Output[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Lower_Output_expected_prev);
		$display ("     Real value = %b", Lower_Output_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_Lower_Output_exp[0] = Lower_Output_expected_prev[0];
	end
	if (
		( Lower_Output_expected_prev[1] !== 1'bx ) && ( Lower_Output_prev[1] !== Lower_Output_expected_prev[1] )
		&& ((Lower_Output_expected_prev[1] !== last_Lower_Output_exp[1]) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Lower_Output[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Lower_Output_expected_prev);
		$display ("     Real value = %b", Lower_Output_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_Lower_Output_exp[1] = Lower_Output_expected_prev[1];
	end
	if (
		( Lower_Output_expected_prev[2] !== 1'bx ) && ( Lower_Output_prev[2] !== Lower_Output_expected_prev[2] )
		&& ((Lower_Output_expected_prev[2] !== last_Lower_Output_exp[2]) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Lower_Output[2] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Lower_Output_expected_prev);
		$display ("     Real value = %b", Lower_Output_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_Lower_Output_exp[2] = Lower_Output_expected_prev[2];
	end
	if (
		( Lower_Output_expected_prev[3] !== 1'bx ) && ( Lower_Output_prev[3] !== Lower_Output_expected_prev[3] )
		&& ((Lower_Output_expected_prev[3] !== last_Lower_Output_exp[3]) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Lower_Output[3] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Lower_Output_expected_prev);
		$display ("     Real value = %b", Lower_Output_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_Lower_Output_exp[3] = Lower_Output_expected_prev[3];
	end
	if (
		( Lower_Output_expected_prev[4] !== 1'bx ) && ( Lower_Output_prev[4] !== Lower_Output_expected_prev[4] )
		&& ((Lower_Output_expected_prev[4] !== last_Lower_Output_exp[4]) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Lower_Output[4] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Lower_Output_expected_prev);
		$display ("     Real value = %b", Lower_Output_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_Lower_Output_exp[4] = Lower_Output_expected_prev[4];
	end
	if (
		( Lower_Output_expected_prev[5] !== 1'bx ) && ( Lower_Output_prev[5] !== Lower_Output_expected_prev[5] )
		&& ((Lower_Output_expected_prev[5] !== last_Lower_Output_exp[5]) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Lower_Output[5] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Lower_Output_expected_prev);
		$display ("     Real value = %b", Lower_Output_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_Lower_Output_exp[5] = Lower_Output_expected_prev[5];
	end
	if (
		( Lower_Output_expected_prev[6] !== 1'bx ) && ( Lower_Output_prev[6] !== Lower_Output_expected_prev[6] )
		&& ((Lower_Output_expected_prev[6] !== last_Lower_Output_exp[6]) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Lower_Output[6] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Lower_Output_expected_prev);
		$display ("     Real value = %b", Lower_Output_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_Lower_Output_exp[6] = Lower_Output_expected_prev[6];
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module Lab6Q3_vlg_vec_tst();
// constants                                           
// general purpose registers
reg [7:0] A;
reg A_Latch_Reset;
reg [7:0] B;
reg B_Latch_Reset;
reg Clock;
reg Decoder_Enabler;
reg FSM_Data_In;
reg FSM_Reset;
// wires                                               
wire [0:6] ID_Output;
wire [0:6] Lower_Output;

wire sampler;                             

// assign statements (if any)                          
Lab6Q3 i1 (
// port map - connection between master ports and signals/registers   
	.A(A),
	.A_Latch_Reset(A_Latch_Reset),
	.B(B),
	.B_Latch_Reset(B_Latch_Reset),
	.Clock(Clock),
	.Decoder_Enabler(Decoder_Enabler),
	.FSM_Data_In(FSM_Data_In),
	.FSM_Reset(FSM_Reset),
	.ID_Output(ID_Output),
	.Lower_Output(Lower_Output)
);
// A[ 7 ]
initial
begin
	A[7] = 1'b1;
end 
// A[ 6 ]
initial
begin
	A[6] = 1'b0;
end 
// A[ 5 ]
initial
begin
	A[5] = 1'b0;
end 
// A[ 4 ]
initial
begin
	A[4] = 1'b0;
end 
// A[ 3 ]
initial
begin
	A[3] = 1'b0;
end 
// A[ 2 ]
initial
begin
	A[2] = 1'b1;
end 
// A[ 1 ]
initial
begin
	A[1] = 1'b0;
end 
// A[ 0 ]
initial
begin
	A[0] = 1'b1;
end 
// B[ 7 ]
initial
begin
	B[7] = 1'b0;
end 
// B[ 6 ]
initial
begin
	B[6] = 1'b0;
end 
// B[ 5 ]
initial
begin
	B[5] = 1'b0;
end 
// B[ 4 ]
initial
begin
	B[4] = 1'b1;
end 
// B[ 3 ]
initial
begin
	B[3] = 1'b0;
end 
// B[ 2 ]
initial
begin
	B[2] = 1'b0;
end 
// B[ 1 ]
initial
begin
	B[1] = 1'b1;
end 
// B[ 0 ]
initial
begin
	B[0] = 1'b0;
end 

// FSM_Data_In
initial
begin
	FSM_Data_In = 1'b0;
	FSM_Data_In = #120000 1'b1;
end 

// Decoder_Enabler
initial
begin
	Decoder_Enabler = 1'b1;
end 

// Clock
initial
begin
	Clock = 1'b0;
	Clock = #10000 1'b1;
	Clock = #70000 1'b0;
	Clock = #40000 1'b1;
	Clock = #70000 1'b0;
	Clock = #50000 1'b1;
	Clock = #60000 1'b0;
	Clock = #20000 1'b1;
	Clock = #60000 1'b0;
	Clock = #20000 1'b1;
	Clock = #40000 1'b0;
	Clock = #40000 1'b1;
	Clock = #70000 1'b0;
	Clock = #50000 1'b1;
	Clock = #60000 1'b0;
	Clock = #40000 1'b1;
	Clock = #50000 1'b0;
	Clock = #30000 1'b1;
	Clock = #60000 1'b0;
	Clock = #30000 1'b1;
	Clock = #50000 1'b0;
	Clock = #40000 1'b1;
end 

Lab6Q3_vlg_sample_tst tb_sample (
	.A(A),
	.A_Latch_Reset(A_Latch_Reset),
	.B(B),
	.B_Latch_Reset(B_Latch_Reset),
	.Clock(Clock),
	.Decoder_Enabler(Decoder_Enabler),
	.FSM_Data_In(FSM_Data_In),
	.FSM_Reset(FSM_Reset),
	.sampler_tx(sampler)
);

Lab6Q3_vlg_check_tst tb_out(
	.ID_Output(ID_Output),
	.Lower_Output(Lower_Output),
	.sampler_rx(sampler)
);
endmodule

